{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/jogadores-2",
      "destination": "/jogadores",
      "permanent": true
    },
    {
      "source": "/category/:cat",
      "destination": "/jogadores",
      "permanent": true
